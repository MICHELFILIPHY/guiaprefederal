        let selectedModality = 'ALL';

        function setModalityFilter(mod) {
            selectedModality = mod;
            document.querySelectorAll('.modality-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-[#00abb1]', 'text-white');
                btn.classList.add('bg-white', 'text-slate-700');
            });
            event.target.classList.add('active', 'bg-[#00abb1]', 'text-white');
            event.target.classList.remove('bg-white', 'text-slate-700');
            applyVagasFilter();
        }

        function applyVagasFilter() {
            const selectedCampus = document.getElementById('campus-select').value;
            const searchVal = document.getElementById('vagas-search-input').value.toLowerCase().trim();
            const tbody = document.getElementById('vagas-table-body');
            const noResults = document.getElementById('vagas-no-results');

            tbody.innerHTML = '';
            let count = 0;

            vagasData.forEach(item => {
                const matchesCampus = (selectedCampus === 'ALL' || item.campus === selectedCampus);
                const matchesModality = (selectedModality === 'ALL' || item.mod === selectedModality);
                const matchesSearch = (searchVal === '' || item.curso.toLowerCase().includes(searchVal) || item.campus.toLowerCase().includes(searchVal));

                if (matchesCampus && matchesModality && matchesSearch) {
                    count++;
                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-teal-50/50 transition border-b border-slate-100 text-center";
                    tr.innerHTML = `
                        <td class="py-3 px-3 text-left">
                            <strong class="text-slate-900 block text-xs">${item.curso}</strong>
                            <span class="text-[10px] text-teal-800 font-bold"><i class="fas fa-building mr-1"></i>${item.campus}</span>
                        </td>
                        <td class="py-3 px-2 font-bold text-slate-700 text-[11px]">${item.mod}</td>
                        <td class="py-3 px-2 font-semibold text-slate-500 text-[11px]">${item.turno}</td>
                        <td class="py-3 px-2 font-black text-teal-900 bg-teal-50/60">${item.ac}</td>
                        <td class="py-3 px-2 text-slate-800">${item.lb_ppi}</td>
                        <td class="py-3 px-2 text-slate-800">${item.lb_ep}</td>
                        <td class="py-3 px-2 text-slate-800">${item.lb_q}</td>
                        <td class="py-3 px-2 text-slate-800">${item.lb_pcd}</td>
                        <td class="py-3 px-2 text-emerald-950 font-semibold bg-emerald-50/30">${item.li_ppi}</td>
                        <td class="py-3 px-2 text-emerald-950 font-semibold bg-emerald-50/30">${item.li_ep}</td>
                        <td class="py-3 px-2 text-emerald-950 font-semibold bg-emerald-50/30">${item.li_q}</td>
                        <td class="py-3 px-2 text-emerald-950 font-semibold bg-emerald-50/30">${item.li_pcd}</td>
                        <td class="py-3 px-2 font-black text-emerald-800 bg-emerald-100/60 text-sm">${item.total}</td>
                    `;
                    tbody.appendChild(tr);
                }
            });

            if (count === 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }
        }

        // Menu Mobile Toggle
        const mobileBtn = document.getElementById('mobile-menu-btn');
