    <script>
        // Mobile Menu Toggle
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenuButton) {
            mobileMenuButton.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
            mobileMenu.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
            });
        }

        // FAB Toggle
        const fabContainer = document.querySelector('.fab-container');
        const fabMainButton = document.getElementById('fab-main-button');
        if (fabMainButton) {
            fabMainButton.addEventListener('click', (e) => {
                e.stopPropagation();
                fabContainer.classList.toggle('active');
            });
            document.addEventListener('click', (e) => {
                if (!fabContainer.contains(e.target)) {
                    fabContainer.classList.remove('active');
                }
            });
        }

        // Filtro de Campi
        function filterCampus(campusName) {
            document.querySelectorAll('.campus-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-slate-900', 'text-white');
                btn.classList.add('bg-white', 'text-slate-800');
            });

            event.currentTarget.classList.add('active', 'bg-slate-900', 'text-white');
            event.currentTarget.classList.remove('bg-white', 'text-slate-800');

            const cards = document.querySelectorAll('.campus-card');
            cards.forEach(card => {
                const campus = card.getAttribute('data-campus');
                if (campusName === 'ALL' || campus === campusName) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Abas do Conteúdo Programático
        function showSubject(subjectId) {
            document.querySelectorAll('.subject-tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            event.currentTarget.classList.add('active');

            document.querySelectorAll('.subject-content').forEach(content => {
                content.classList.add('hidden');
                content.classList.remove('block');
            });

            const target = document.getElementById('subject-' + subjectId);
            if (target) {
                target.classList.remove('hidden');
                target.classList.add('block');
            }
        }
    </script>
