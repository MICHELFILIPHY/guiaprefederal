        function getMarkerColor(count) {
            if (count >= 10) return '#f43f5e'; // Rose P1
            if (count >= 4) return '#f59e0b';  // Amber P2
            return '#38bdf8';                  // Sky P3
        }

        function getMarkerRadius(count) {
            if (count >= 25) return 24;
            if (count >= 12) return 18;
            if (count >= 6) return 13;
            if (count >= 3) return 9;
            return 6;
        }

        function renderStudentMarkers() {
            studentsLayer.clearLayers();

            rawStudentCities.forEach(item => {
                const matchesTier = (currentTier === 'ALL') ||
                                    (currentTier === 'P1' && item.count >= 10) ||
                                    (currentTier === 'P2' && item.count >= 4 && item.count < 10) ||
                                    (currentTier === 'P3' && item.count < 4);

                if (matchesTier) {
                    const radius = getMarkerRadius(item.count);
                    const color = getMarkerColor(item.count);

                    const marker = L.circleMarker([item.lat, item.lng], {
                        radius: radius,
                        fillColor: color,
                        color: '#ffffff',
                        weight: 1.5,
                        opacity: 0.9,
                        fillOpacity: 0.75
                    });

                    const percent = ((item.count / TOTAL_ALUNOS) * 100).toFixed(1);
                    const tierLabel = item.count >= 10 ? 'P1 • Hiper Quente' : (item.count >= 4 ? 'P2 • Em Tração' : 'P3 • Expansão');
                    const badgeClass = item.count >= 10 ? 'bg-rose-500/20 text-rose-300 border-rose-500/40' : (item.count >= 4 ? 'bg-amber-500/20 text-amber-300 border-amber-500/40' : 'bg-sky-500/20 text-sky-300 border-sky-500/40');

                    const popup = `
