        function renderGravityLines() {
            gravityLinesLayer.clearLayers();
            if (!showLines) return;

            rawStudentCities.forEach(item => {
                const pole = federalPoles.find(p => p.id === item.poleId);
                if (pole) {
                    const weight = item.count >= 10 ? 2 : (item.count >= 4 ? 1.2 : 0.6);
                    const opacity = item.count >= 10 ? 0.65 : (item.count >= 4 ? 0.45 : 0.25);
                    const color = item.count >= 10 ? '#f43f5e' : (item.count >= 4 ? '#f59e0b' : '#38bdf8');

                    const polyline = L.polyline([[item.lat, item.lng], [pole.lat, pole.lng]], {
                        color: color,
                        weight: weight,
                        opacity: opacity,
                        dashArray: item.distanceToPole > 40 ? '4, 4' : null
                    });

                    polyline.bindTooltip(`${item.city} &rarr; ${pole.name} (~${item.distanceToPole} km)`, { sticky: true });
                    gravityLinesLayer.addLayer(polyline);
                }
            });
        }

