                    badge = `<span class="bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[9px] font-black px-2 py-0.5 rounded uppercase">P2 • Em Tração</span>`;
                } else {
                    badge = `<span class="bg-sky-500/20 text-sky-300 border border-sky-500/30 text-[9px] font-black px-2 py-0.5 rounded uppercase">P3 • Expansão</span>`;
                }

                const distColor = item.distanceToPole <= 25 ? 'text-emerald-400 font-bold' : (item.distanceToPole <= 60 ? 'text-amber-400' : 'text-slate-400');

                tr.innerHTML = `
                    <td class="py-2.5 px-3 text-center text-slate-500 font-mono font-bold">${index + 1}º</td>
                    <td class="py-2.5 px-4 font-bold text-white flex items-center space-x-1.5">
                        <span>${item.city}</span>
                        <span class="text-slate-500 text-[10px]">(${item.uf})</span>
                    </td>
                    <td class="py-2.5 px-3 text-center font-mono font-black ${item.count >= 10 ? 'text-rose-400 text-sm' : (item.count >= 4 ? 'text-amber-400' : 'text-slate-200')}">${item.count}</td>
                    <td class="py-2.5 px-3 text-center font-mono text-slate-400">${percent}%</td>
                    <td class="py-2.5 px-4 text-slate-300 text-[11px]">${item.school}</td>
                    <td class="py-2.5 px-3 text-center font-mono ${distColor}">~${item.distanceToPole} km</td>
                    <td class="py-2.5 px-3 text-center">${badge}</td>
                    <td class="py-2.5 px-3 text-center">
                        <button onclick="zoomToCity(${item.lat}, ${item.lng}, '${item.city}')" class="text-xs text-sky-400 hover:text-sky-300 font-bold p-1 hover:bg-slate-800 rounded transition" title="Focar no mapa">
                            <i class="fas fa-crosshairs"></i>
                        </button>
                    </td>
                `;

                tbody.appendChild(tr);
            });

            document.getElementById('displayedCount').innerText = sorted.length;
        }

        function filterFullTable() {
            const query = document.getElementById('tableSearch').value.toLowerCase().trim();
            const selectedUf = document.getElementById('stateSelectFilter').value;

            const filtered = rawStudentCities.filter(item => {
                const matchesQuery = (query === '' ||
                                      item.city.toLowerCase().includes(query) ||
                                      item.school.toLowerCase().includes(query) ||
                                      item.uf.toLowerCase().includes(query));

                let matchesUf = true;
                if (selectedUf === 'MG') matchesUf = item.uf === 'MG';
                else if (selectedUf === 'RJ') matchesUf = item.uf === 'RJ';
                else if (selectedUf === 'ES') matchesUf = item.uf === 'ES';
                else if (selectedUf === 'SP') matchesUf = item.uf === 'SP';
                else if (selectedUf === 'OUTROS') matchesUf = !['MG','RJ','ES','SP'].includes(item.uf);

                return matchesQuery && matchesUf;
            });

            renderFullTable(filtered);
        }

        function zoomToCity(lat, lng, name) {
            window.scrollTo({ top: document.getElementById('map').offsetTop - 90, behavior: 'smooth' });
            map.flyTo([lat, lng], 10, { duration: 1.2 });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initDashboardMap();
            initCharts();
            renderFullTable();
        });
    </script>
</body>
</html>
