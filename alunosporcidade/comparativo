<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Executivo de Geomarketing & Gravidade de Polos Federais | Guia Pré-Federal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts - Inter & JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <style>
        :root {
            --brand-navy: #090d16;
            --brand-card: #111827;
            --brand-border: #1f2937;
            --brand-accent: #38bdf8;
            --brand-lime: #c7ef59;
            --brand-coral: #dd5737;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            color: #f1f5f9;
        }
        .mono {
            font-family: 'JetBrains Mono', monospace;
        }
        #map {
            height: 680px;
            width: 100%;
            border-radius: 1rem;
            z-index: 10;
            background-color: #0f172a;
        }
        .leaflet-popup-content-wrapper {
            background-color: #111827;
            color: #f8fafc;
            border-radius: 0.75rem;
            border: 1px solid #374151;
            box-shadow: 0 15px 30px rgba(0,0,0,0.6);
            font-family: 'Inter', sans-serif;
            padding: 0.25rem;
        }
        .leaflet-popup-tip {
            background-color: #111827;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #111827;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }
    </style>
</head>
<body class="min-h-full flex flex-col justify-between antialiased text-slate-100">

    <!-- Top Executive Header Bar -->
    <header class="bg-[#0f172a]/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50 py-3 px-4 sm:px-8">
        <div class="max-w-[1700px] mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            
            <div class="flex items-center space-x-3.5">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center p-1.5 shadow-lg border border-white/10" style="background-color: #dd5737;">
                    <img src="./logo.png" onerror="this.onerror=null; this.src='https://placehold.co/100x100/dd5737/ffffff?text=GPF';" alt="Guia Pré-Federal" class="w-full h-full object-contain">
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <span class="text-base font-black tracking-tight text-white uppercase">Guia Pré-Federal</span>
                        <span class="bg-indigo-500/20 text-indigo-300 text-[10px] font-black uppercase px-2 py-0.5 rounded border border-indigo-500/30">Uso Interno</span>
                    </div>
                    <p class="text-xs text-slate-400 font-medium">Painel de Decisão de Mídia Paga & Análise Espacial de Alunos vs. Polos Federais</p>
                </div>
            </div>

            <!-- Global KPI Badges -->
            <div class="flex flex-wrap items-center gap-2.5 text-xs">
                <div class="bg-slate-900 border border-slate-800 rounded-xl px-3.5 py-1.5 flex items-center space-x-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-slate-400 font-bold uppercase text-[10px]">Alunos Auditados:</span>
                    <span class="font-black text-emerald-300 mono text-sm" id="header-students-count">448</span>
                </div>
                <div class="bg-slate-900 border border-slate-800 rounded-xl px-3.5 py-1.5 flex items-center space-x-2">
                    <i class="fas fa-city text-sky-400 text-xs"></i>
                    <span class="text-slate-400 font-bold uppercase text-[10px]">Cidades:</span>
                    <span class="font-black text-sky-300 mono text-sm" id="header-cities-count">139</span>
                </div>
                <div class="bg-slate-900 border border-slate-800 rounded-xl px-3.5 py-1.5 flex items-center space-x-2">
                    <i class="fas fa-university text-amber-400 text-xs"></i>
                    <span class="text-slate-400 font-bold uppercase text-[10px]">Polos Federais:</span>
                    <span class="font-black text-amber-300 mono text-sm" id="header-schools-count">14</span>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-[1700px] w-full mx-auto px-4 sm:px-8 py-6 space-y-6">

        <!-- Macro KPIs Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3.5">
            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-4 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-rose-500/10 rounded-full blur-xl pointer-events-none"></div>
                <span class="text-[10px] font-black uppercase tracking-wider text-rose-400 flex items-center"><i class="fas fa-fire mr-1.5"></i>Zona da Mata & Vertentes</span>
                <div class="text-2xl font-black text-white mt-1 mono">160 <span class="text-xs font-semibold text-rose-300 font-sans">(35,7%)</span></div>
                <p class="text-[11px] text-slate-400 mt-1 leading-tight">Polo IF Sudeste MG + COLUNI</p>
            </div>

            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-4 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-sky-500/10 rounded-full blur-xl pointer-events-none"></div>
                <span class="text-[10px] font-black uppercase tracking-wider text-sky-400 flex items-center"><i class="fas fa-industry mr-1.5"></i>Grande BH & Eixo do Aço</span>
                <div class="text-2xl font-black text-white mt-1 mono">116 <span class="text-xs font-semibold text-sky-300 font-sans">(25,9%)</span></div>
                <p class="text-[11px] text-slate-400 mt-1 leading-tight">COLTEC + CEFET-MG + IFMG</p>
            </div>

            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-4 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-indigo-500/10 rounded-full blur-xl pointer-events-none"></div>
                <span class="text-[10px] font-black uppercase tracking-wider text-indigo-400 flex items-center"><i class="fas fa-water mr-1.5"></i>Estado do Rio (RJ)</span>
                <div class="text-2xl font-black text-white mt-1 mono">33 <span class="text-xs font-semibold text-indigo-300 font-sans">(7,4%)</span></div>
                <p class="text-[11px] text-slate-400 mt-1 leading-tight">CEFET-RJ, IFF, IFRJ e CTUR</p>
            </div>

            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-4 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/10 rounded-full blur-xl pointer-events-none"></div>
                <span class="text-[10px] font-black uppercase tracking-wider text-emerald-400 flex items-center"><i class="fas fa-sun mr-1.5"></i>Norte de Minas (IFNMG)</span>
                <div class="text-2xl font-black text-white mt-1 mono">19 <span class="text-xs font-semibold text-emerald-300 font-sans">(4,2%)</span></div>
                <p class="text-[11px] text-slate-400 mt-1 leading-tight">M. Claros, Pirapora, Jaíba</p>
            </div>

            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-4 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-amber-500/10 rounded-full blur-xl pointer-events-none"></div>
                <span class="text-[10px] font-black uppercase tracking-wider text-amber-400 flex items-center"><i class="fas fa-compass mr-1.5"></i>Raio &le; 30 km de IFs</span>
                <div class="text-2xl font-black text-white mt-1 mono">322 <span class="text-xs font-semibold text-amber-300 font-sans">(71,9%)</span></div>
                <p class="text-[11px] text-slate-400 mt-1 leading-tight">Alunos em cidades-polo ou vizinhas</p>
            </div>

            <div class="bg-slate-900/90 border border-slate-800/80 rounded-2xl p-4 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-[#c7ef59]/10 rounded-full blur-xl pointer-events-none"></div>
                <span class="text-[10px] font-black uppercase tracking-wider text-[#c7ef59] flex items-center"><i class="fas fa-bullseye mr-1.5"></i>Orçamento Recomendado</span>
                <div class="text-2xl font-black text-white mt-1 mono">P1+P2 <span class="text-xs font-semibold text-[#c7ef59] font-sans">85%</span></div>
                <p class="text-[11px] text-slate-400 mt-1 leading-tight">Foco em 28 cidades estratégicas</p>
            </div>
        </div>

        <!-- Map and Spatial Intelligence Section -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-4 sm:p-6 shadow-xl space-y-4">
            
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-2 border-b border-slate-800">
                <div>
                    <h2 class="text-lg sm:text-xl font-black text-white flex items-center">
                        <i class="fas fa-map-marked-alt text-sky-400 mr-2.5"></i>Mapa Interativo de Gravidade de Alunos & Escolas Federais
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5">
                        Marcadores coloridos representam cidades com alunos (tamanho proporcional ao volume). Marcadores navais escuros indicam os Campi Federais. Linhas mostram a conexão gravitacional com o polo federal mais próximo.
                    </p>
                </div>

                <!-- Map Filter Controls -->
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-[11px] font-bold text-slate-400 uppercase mr-1">Camadas:</span>
                    <button onclick="toggleLines()" id="btn-toggle-lines" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition flex items-center">
                        <i class="fas fa-project-diagram mr-1.5 text-sky-400"></i> Linhas Gravitacionais (On)
                    </button>
                    <button onclick="toggleRings()" id="btn-toggle-rings" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition flex items-center">
                        <i class="fas fa-circle-notch mr-1.5 text-amber-400"></i> Raios de Influência 40 km (On)
                    </button>
                    <button onclick="filterMapByTier('ALL')" class="map-tier-btn active px-3 py-1.5 rounded-xl text-xs font-black bg-indigo-600 text-white border border-indigo-500 transition">
                        Todos
                    </button>
                    <button onclick="filterMapByTier('P1')" class="map-tier-btn px-3 py-1.5 rounded-xl text-xs font-black bg-slate-800 hover:bg-slate-700 text-rose-400 border border-slate-700 transition">
                        P1 (&ge; 10 alunos)
                    </button>
                    <button onclick="filterMapByTier('P2')" class="map-tier-btn px-3 py-1.5 rounded-xl text-xs font-black bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 transition">
                        P2 (4 a 9 alunos)
                    </button>
                    <button onclick="filterMapByTier('P3')" class="map-tier-btn px-3 py-1.5 rounded-xl text-xs font-black bg-slate-800 hover:bg-slate-700 text-sky-400 border border-slate-700 transition">
                        P3 (1 a 3 alunos)
                    </button>
                </div>
            </div>

            <!-- Leaflet Map Container -->
            <div id="map"></div>

            <!-- Map Legend -->
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3 pt-2 text-xs">
                <div class="flex items-center space-x-2.5 bg-slate-800/60 p-2.5 rounded-xl border border-slate-700/60">
                    <span class="w-4 h-4 rounded-full bg-rose-500 border border-white shadow-md flex-shrink-0"></span>
                    <span class="text-slate-300 text-[11px]"><strong>P1 • Hiper Quente:</strong> 10 a 29 alunos</span>
                </div>
                <div class="flex items-center space-x-2.5 bg-slate-800/60 p-2.5 rounded-xl border border-slate-700/60">
                    <span class="w-4 h-4 rounded-full bg-amber-500 border border-white shadow-md flex-shrink-0"></span>
                    <span class="text-slate-300 text-[11px]"><strong>P2 • Em Tração:</strong> 4 a 9 alunos</span>
                </div>
                <div class="flex items-center space-x-2.5 bg-slate-800/60 p-2.5 rounded-xl border border-slate-700/60">
                    <span class="w-4 h-4 rounded-full bg-sky-500 border border-white shadow-md flex-shrink-0"></span>
                    <span class="text-slate-300 text-[11px]"><strong>P3 • Presença Dispersa:</strong> 1 a 3 alunos</span>
                </div>
                <div class="flex items-center space-x-2.5 bg-slate-800/60 p-2.5 rounded-xl border border-slate-700/60">
                    <span class="w-4 h-4 rounded-full bg-[#1e293b] border-2 border-amber-400 shadow-md flex-shrink-0 flex items-center justify-center text-[8px] text-amber-400 font-bold"><i class="fas fa-university"></i></span>
                    <span class="text-slate-300 text-[11px]"><strong>Campus Federal:</strong> Polo de Atração</span>
                </div>
                <div class="flex items-center space-x-2.5 bg-slate-800/60 p-2.5 rounded-xl border border-slate-700/60">
                    <span class="w-5 h-0.5 bg-cyan-400"></span>
                    <span class="text-slate-300 text-[11px]"><strong>Vetor Gravitacional:</strong> Conexão Cidade &rarr; IF</span>
                </div>
            </div>
        </div>

        <!-- Strategic Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Chart 1: Alunos por Polo Federal de Atração -->
            <div class="lg:col-span-6 bg-slate-900 border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-xl flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-sm font-black uppercase text-slate-200 flex items-center">
                            <i class="fas fa-magnet text-amber-400 mr-2"></i>Gravidade: Volume de Alunos por Polo Federal
                        </h3>
                        <span class="text-[10px] font-bold text-slate-400 uppercase bg-slate-800 px-2 py-0.5 rounded">Destino dos Alunos</span>
                    </div>
                    <p class="text-xs text-slate-400 mb-4">
                        Soma de alunos em municípios cuja atração principal é o respectivo campus ou instituto federal.
                    </p>
                </div>
                <div class="relative h-[320px]">
                    <canvas id="chartPolesGravity"></canvas>
                </div>
            </div>

            <!-- Chart 2: Top 12 Cidades com Mais Alunos -->
            <div class="lg:col-span-6 bg-slate-900 border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-xl flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-sm font-black uppercase text-slate-200 flex items-center">
                            <i class="fas fa-chart-bar text-sky-400 mr-2"></i>Top 12 Cidades por Volume Absoluto
                        </h3>
                        <span class="text-[10px] font-bold text-slate-400 uppercase bg-slate-800 px-2 py-0.5 rounded">Densidade Pura</span>
                    </div>
                    <p class="text-xs text-slate-400 mb-4">
                        Estas 12 cidades concentram 164 alunos (36,6% da base do cursinho).
                    </p>
                </div>
                <div class="relative h-[320px]">
                    <canvas id="chartTopCities"></canvas>
                </div>
            </div>

            <!-- Chart 3: Distribuição Geográfica por Estado -->
            <div class="lg:col-span-4 bg-slate-900 border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-xl flex flex-col justify-between">
                <div>
                    <h3 class="text-sm font-black uppercase text-slate-200 mb-1 flex items-center">
                        <i class="fas fa-chart-pie text-emerald-400 mr-2"></i>Distribuição por Estado (UF)
                    </h3>
                    <p class="text-xs text-slate-400 mb-4">Percentual da base total por unidade federativa.</p>
                </div>
                <div class="relative h-[260px] flex items-center justify-center">
                    <canvas id="chartStateShare"></canvas>
                </div>
                <div class="mt-3 text-center text-[11px] text-slate-400">
                    Minas Gerais concentra <strong class="text-white">88,6%</strong> dos estudantes cadastrados.
                </div>
            </div>

            <!-- Chart 4: Recomendação de Alocação de Orçamento de Mídia Paga -->
            <div class="lg:col-span-8 bg-slate-900 border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-xl flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <h3 class="text-sm font-black uppercase text-slate-200 flex items-center">
                            <i class="fas fa-coins text-[#c7ef59] mr-2"></i>Divisão Tática de Orçamento de Mídia (Meta & Google Ads)
                        </h3>
                        <span class="text-[10px] font-bold text-lime-400 bg-lime-950/60 border border-lime-500/30 px-2.5 py-0.5 rounded">Estratégia Recomendada</span>
                    </div>
                    <p class="text-xs text-slate-400 mb-4">
                        Distribuição da verba orientada pela concentração real de matrículas e proximidade das bancas de maior atração.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 text-xs">
                    <div class="bg-rose-950/20 border border-rose-500/30 rounded-2xl p-4 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-center mb-1.5">
                                <span class="font-black text-rose-400 uppercase text-[11px]">Cluster Zona da Mata</span>
                                <span class="font-black text-white bg-rose-900/60 px-2 py-0.5 rounded text-xs">45% da Verba</span>
                            </div>
                            <p class="text-slate-300 text-[11px] leading-relaxed">
                                <strong>Polo IF Sudeste MG + COLUNI UFV.</strong> Cidades: Juiz de Fora (26), Leopoldina (15), Laranjal (14), Cataguases (9), Jequeri (9), Senador Firmino (7), Muriaé, Piraúba, Viçosa e Ubá.
                            </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-rose-500/20 text-[10px] text-rose-300">
                            <strong>Ação:</strong> Anúncios no Meta Ads por raio (15-25 km) em JF, Leopoldina e Viçosa com chamadas para cursos técnicos e aprovação no COLUNI.
                        </div>
                    </div>

                    <div class="bg-sky-950/20 border border-sky-500/30 rounded-2xl p-4 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-center mb-1.5">
                                <span class="font-black text-sky-400 uppercase text-[11px]">Cluster RMBH & Aço</span>
                                <span class="font-black text-white bg-sky-900/60 px-2 py-0.5 rounded text-xs">30% da Verba</span>
                            </div>
                            <p class="text-slate-300 text-[11px] leading-relaxed">
                                <strong>Polo COLTEC + CEFET-MG + IFMG.</strong> Cidades: Belo Horizonte (29), Contagem (14), Congonhas (13), Betim (12), Conselheiro Lafaiete (8), Monlevade (8), Ipatinga e Ouro Branco.
                            </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-sky-500/20 text-[10px] text-sky-300">
                            <strong>Ação:</strong> Campanhas para pais e alunos com ênfase no livro de literatura obrigatória (*Adélia Prado*) e simulados de alto nível.
                        </div>
                    </div>

                    <div class="bg-indigo-950/20 border border-indigo-500/30 rounded-2xl p-4 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-center mb-1.5">
                                <span class="font-black text-indigo-400 uppercase text-[11px]">Cluster Expansão</span>
                                <span class="font-black text-white bg-indigo-900/60 px-2 py-0.5 rounded text-xs">25% da Verba</span>
                            </div>
                            <p class="text-slate-300 text-[11px] leading-relaxed">
                                <strong>Rio de Janeiro, Norte e Triângulo.</strong> Cidades: Rio de Janeiro (14), Montes Claros (9), Niterói (4), Belford Roxo, Sete Lagoas, Uberlândia e Uberaba.
                            </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-indigo-500/20 text-[10px] text-indigo-300">
                            <strong>Ação:</strong> Google Search (intenção de busca para CEFET-RJ, CTUR, IFNMG e IFTM) e Lookalike 1% da lista completa de alunos.
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Full Data Table Section -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-xl space-y-4">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3 border-b border-slate-800">
                <div>
                    <h3 class="text-base sm:text-lg font-black text-white flex items-center">
                        <i class="fas fa-table-list text-sky-400 mr-2.5"></i>Matriz Completa de Cidades: Gravidade, Alunos e Distância aos Campi
                    </h3>
                    <p class="text-xs text-slate-400">Total de 139 municípios mapeados com a instituição federal mais próxima e recomendação tática.</p>
                </div>

                <div class="flex items-center space-x-2.5">
                    <div class="relative">
                        <i class="fas fa-search absolute left-3 top-3 text-slate-500 text-xs"></i>
                        <input type="text" id="tableSearch" onkeyup="filterFullTable()" placeholder="Buscar cidade, UF ou polo..." class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl pl-8 pr-4 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-sky-500 w-56 sm:w-72">
                    </div>
                    <select id="stateSelectFilter" onchange="filterFullTable()" class="bg-slate-950 border border-slate-700 text-xs text-white rounded-xl px-3 py-2 font-medium focus:outline-none focus:ring-2 focus:ring-sky-500">
                        <option value="ALL">Todas as UFs</option>
                        <option value="MG">Apenas MG</option>
                        <option value="RJ">Apenas RJ</option>
                        <option value="ES">Apenas ES</option>
                        <option value="SP">Apenas SP</option>
                        <option value="OUTROS">Outros Estados</option>
                    </select>
                </div>
            </div>

            <!-- Table Container -->
            <div class="overflow-x-auto rounded-2xl border border-slate-800 max-h-[500px] overflow-y-auto custom-scrollbar">
                <table class="w-full text-left border-collapse text-xs">
